{
  "name": "@openmrs/eslint-config",
  "version": "2.1.0",
  "description": "Standardized ESLint configuration for OpenMRS O3 frontend modules",
  "license": "MPL-2.0",
  "homepage": "https://github.com/openmrs/openmrs-contrib-eslint-config#readme",
  "bugs": "https://github.com/openmrs/openmrs-contrib-eslint-config/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-contrib-eslint-config.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./base": "./configs/base.js",
    "./react": "./configs/react.js",
    "./test": "./configs/test.js",
    "./e2e": "./configs/e2e.js",
    "./react-types": "./configs/react-types.js"
  },
  "files": [
    "index.js",
    "configs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/react-types.mjs"
  },
  "keywords": [
    "openmrs",
    "o3",
    "eslint",
    "eslintconfig",
    "eslint-config"
  ],
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "eslint": "^9.39.0",
    "typescript": ">=5"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "typescript": "^5.6.0"
  }
}
